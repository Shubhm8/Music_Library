<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Add New Songs</title>

<style>
:root { 
    --bg: #F5F5F7; 
    --surface: #FFFFFF; 
    --text: #1D1D1F; 
    --secondary: #86868b;
    --accent: #FF2D55; 
    --border: #E5E5EA; 
    --radius: 18px; 
}

* { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, Inter, sans-serif; }

body { 
    background: var(--bg); 
    min-height: 100vh;
    display: flex;
    flex-direction: column; 
}

.page-wrapper {
    flex: 1;
    display: flex;
    justify-content: center;
    padding: 40px;
}
 
.container { 
    width: 100%; 
    max-width: 650px; 
    background: var(--surface); 
    padding: 40px; 
    border-radius: var(--radius); 
    border: 1px solid var(--border); 
    box-shadow: 0 10px 30px rgba(0,0,0,0.08); 
}
.page-header{

display:flex;

align-items:center;

gap:20px;

margin-bottom:40px;

}

.header-icon{

width:80px;

height:80px;

border-radius:24px;

background:linear-gradient(135deg,#ff2d55,#ff6b81);

display:flex;

justify-content:center;

align-items:center;

font-size:36px;

color:white;

box-shadow:0 12px 30px rgba(255,45,85,.25);

}

.page-header h1{

font-size:38px;

font-weight:800;

color:#1D1D1F;

margin-bottom:6px;

}

.page-header p{

font-size:16px;

color:#86868b;

}


.form-group { margin-bottom: 20px; }
.form-grid{

display:grid;

grid-template-columns:repeat(2,1fr);

gap:22px;

margin-bottom:30px;

}

@media(max-width:800px){

.form-grid{

grid-template-columns:1fr;

}

}

label { 
    display: block; 
    font-weight: 600; 
    margin-bottom: 8px; 
    color: var(--text); 
    font-size: 14px;
}

input[type="text"], 
input[type="number"],
input[type="date"], 
select { 
    width: 100%; 
    padding: 14px; 
    border-radius: 12px; 
    border: 1.5px solid var(--border); 
    font-size: 15px; 
    background: #FAFAFC;
    transition: 0.2s;
    font-family: inherit;
}

input[type=number]::-webkit-inner-spin-button, 
input[type=number]::-webkit-outer-spin-button { 
  -webkit-appearance: none; 
  margin: 0; 
}

input:focus, select:focus { 
    outline: none; 
    border-color: var(--accent); 
    background: #FFF;
}

.file-upload-wrapper {
    position: relative;
    height: 120px;
    border: 2px dashed #D1D1D6;
    border-radius: 12px;
    background: #FAFAFC;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    transition: all 0.2s ease;
    overflow: hidden;
}

.file-upload-wrapper:hover {
    border-color: var(--accent);
    background: #FFF0F3; 
}

.file-upload-wrapper.has-file {
    border-style: solid;
    border-color: #34C759;  
    background: #f0fdf4;
}

.file-upload-wrapper input[type="file"] {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    opacity: 0;
    cursor: pointer;
    z-index: 10;
}

.upload-icon { font-size: 28px; margin-bottom: 8px; display: block; }
.upload-text { font-size: 13px; color: var(--secondary); font-weight: 500; padding: 0 10px; }

.btn { 
    width: 100%; 
    padding: 16px; 
    background: var(--accent); 
    color: white; 
    border: none; 
    border-radius: 12px; 
    font-weight: 700; 
    font-size: 16px;
    cursor: pointer; 
    margin-top: 15px; 
    transition: 0.2s;
}
.btn:hover { background: #e0244a; transform: translateY(-2px); }

.btn-cancel { 
    display: block; 
    text-align: center; 
    background: #E5E5EA; 
    color: #1D1D1F; 
    text-decoration: none; 
    margin-top: 12px; 
}
.btn-cancel:hover { background: #d1d1d6; }

.error-msg {
    background: #ffe5ea;
    color: #c00026;
    padding: 15px;
    border-radius: 12px;
    margin-bottom: 25px;
    text-align: center;
    font-weight: 600;
    font-size: 14px;
    border: 1px solid #ffccd4;
}
 

@keyframes fadeUp{
from{opacity:0;transform:translateY(20px);}
to{opacity:1;transform:none;}
}
.container{animation:fadeUp .5s ease;}
.file-upload-wrapper.dragover{
    border-color:var(--accent);
    background:#fff0f3;
    transform:scale(1.02);
}
.preview-image{
    max-width:100%;
    max-height:90px;
    border-radius:10px;
    margin-top:8px;
    display:none;
}
.action-bar{

display:flex;

justify-content:flex-end;

gap:18px;

margin-top:40px;

}

.btn-upload{

background:linear-gradient(135deg,#0A84FF,#5E5CE6);

padding:16px 34px;

border:none;

border-radius:14px;

font-size:16px;

font-weight:700;

color:#fff;

cursor:pointer;

transition:.3s;

box-shadow:0 12px 30px rgba(10,132,255,.3);

}

.btn-upload:hover{

transform:translateY(-3px);

box-shadow:0 18px 40px rgba(10,132,255,.4);

}

.btn-cancel{

padding:16px 34px;

border-radius:14px;

text-decoration:none;

background:#ececec;

color:#333;

font-weight:700;

transition:.3s;

}

.btn-cancel:hover{

background:#ddd;

}


.upload-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}
.file-upload-wrapper{
    min-height:180px;
    border-radius:18px;
}
.file-upload-wrapper.dragover{
    border-color:var(--accent);
    background:#fff0f3;
    transform:scale(1.02);
}
.preview-image{
    max-width:100%;
    max-height:100px;
    border-radius:12px;
    margin-top:10px;
    display:none;
}
.audio-info{
    margin-top:10px;
    font-size:13px;
    color:var(--secondary);
}
@keyframes fadeUp{
from{opacity:0;transform:translateY(20px);}
to{opacity:1;transform:none;}
}
.container{animation:fadeUp .45s ease;}

footer {
    text-align: center;
    padding: 20px 0;
    color: var(--secondary);
    font-size: 14px;
}
</style>
</head>
<body>

<div class="page-wrapper">

<div class="container">

<div class="page-header">

    <div class="header-icon">
        🎵
    </div>

    <div>

        <h1>Add New Song</h1>

        <p>
            Upload music to your library
        </p>

    </div>

</div>

    <c:if test="${not empty errorMessage}">
        <div class="error-msg">${errorMessage}</div>
    </c:if>

    <form action="/admin/songs/add" method="post" enctype="multipart/form-data">

        <div class="form-group">
            <label>Song ID <span style="color:red">*</span></label>
            <input type="number" name="songId" placeholder="Enter Unique ID (e.g., 101)" required>
        </div>

        <div class="form-group">
            <label>Song Name <span style="color:red">*</span></label>
            <input type="text" name="songName" placeholder="e.g. Blinding Lights" required>
        </div>

        <div class="form-group">
            <label>Singer <span style="color:red">*</span></label>
            <input type="text" name="singer" placeholder="e.g. The Weeknd" required>
        </div>

        <div class="form-group">
            <label>Album Name</label>
            <input type="text" name="albumName" placeholder="e.g. After Hours">
        </div>

        <div class="form-group">
            <label>Music Director</label>
            <input type="text" name="musicDirector" placeholder="e.g. Max Martin">
        </div>

       <div class="form-grid">

    <div class="form-group">
        <label>Song ID</label>
        <input type="number" name="songId" placeholder="101" required>
    </div>

    <div class="form-group">
        <label>Song Name</label>
        <input type="text" name="songName" placeholder="Blinding Lights" required>
    </div>

    <div class="form-group">
        <label>Singer</label>
        <input type="text" name="singer" placeholder="The Weeknd" required>
    </div>

    <div class="form-group">
        <label>Album</label>
        <input type="text" name="albumName" placeholder="After Hours">
    </div>

    <div class="form-group">
        <label>Music Director</label>
        <input type="text" name="musicDirector" placeholder="Max Martin">
    </div>

    <div class="form-group">
        <label>Release Date</label>
        <input type="date" name="releaseDate" max="9999-12-31">
    </div>

    <div class="form-group">
        <label>Song Type</label>
        <select name="songType">
            <option value="FREE">FREE</option>
            <option value="PREMIUM">PREMIUM</option>
        </select>
    </div>

    <div class="form-group">
        <label>Status</label>
        <select name="songStatus">
            <option value="AVAILABLE">AVAILABLE</option>
            <option value="NOTAVAILABLE">NOT AVAILABLE</option>
        </select>
    </div>

</div>

        <div class="upload-grid">

    <div class="upload-card">

        <h3>Cover Image</h3>

        <div class="image-preview" id="imagePreview">
            <span>No Image Selected</span>
        </div>

        <label class="upload-box">

            <input type="file"
                   id="imageInput"
                   name="imageFile"
                   accept="image/*"
                   hidden>

            <div>
                <h4>📷 Choose Cover</h4>
                <p>PNG, JPG or JPEG</p>
            </div>

        </label>

    </div>

    <div class="upload-card">

        <h3>Audio File</h3>

        <div class="audio-preview" id="audioPreview">
            <span>No Audio Selected</span>
        </div>

        <label class="upload-box">

            <input type="file"
                   id="audioInput"
                   name="file"
                   accept=".mp3,.wav"
                   required
                   hidden>

            <div>
                <h4>🎵 Choose Song</h4>
                <p>MP3, WAV</p>
            </div>

        </label>

    </div>

</div>

       <div class="action-bar">

    <a href="/admin/songs" class="btn btn-cancel">
        Cancel
    </a>

    <button type="submit" class="btn btn-upload">
        🎵 Upload Song
    </button>

</div>

    </form>

</div>
</div>

<footer>
    <p>&copy; 2025 Music Library Application. All rights reserved.</p>
</footer>


<script>

const imageInput = document.getElementById("imageInput");
const audioInput = document.getElementById("audioInput");

const imagePreview = document.getElementById("imagePreview");
const audioPreview = document.getElementById("audioPreview");

imageInput.addEventListener("change", function () {

    if (!this.files.length) return;

    const reader = new FileReader();

    reader.onload = function (e) {

        imagePreview.innerHTML =
            `<img src="${e.target.result}" alt="Cover">`;

    };

    reader.readAsDataURL(this.files[0]);

});

audioInput.addEventListener("change", function () {

    if (!this.files.length) return;

    const file = this.files[0];

    const size = (file.size / (1024 * 1024)).toFixed(2);

    audioPreview.innerHTML = `
        <div style="text-align:center;">
            <div style="font-size:40px;">🎵</div>
            <strong>${file.name}</strong>
            <br>
            <span>${size} MB</span>
        </div>
    `;

});

</script>


</body>
</html>
