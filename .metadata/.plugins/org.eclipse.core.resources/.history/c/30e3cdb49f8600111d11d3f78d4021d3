<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Admin Dashboard</title>

<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
<meta http-equiv="Pragma" content="no-cache" />
<meta http-equiv="Expires" content="0" />

<style> 
:root{
    --bg:#F5F5F7;
    --surface:#FFFFFF;
    --text-primary:#1D1D1F;
    --text-secondary:#86868b;
    --accent:#FF2D55;
    --accent-hover:#e01c43;
    --radius:20px;
    --border:#E5E5EA;
    --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    --shadow-hover: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
}

*{margin:0;padding:0;box-sizing:border-box;font-family:-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;}

canvas{
    max-height:300px;
}

body{
    background:var(--bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;   
}

.page-content {
    flex: 1;
    padding-bottom: 40px;
}

.navbar{
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 18px 40px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-bottom:1px solid rgba(0,0,0,0.05);
    position: sticky;
    top: 0;
    z-index: 100;
}

.navbar h2{
    font-size:22px;
    font-weight:700;
    letter-spacing: -0.5px;
}

.logout-btn{
    padding:10px 24px;
    background:var(--text-primary);
    color:white;
    border:none;
    border-radius:30px;
    font-size: 13px;
    font-weight:600;
    cursor:pointer;
    transition:.2s;
}
.logout-btn:hover{ transform: scale(1.02); opacity: 0.9; }

.container{ 
    max-width:1100px; 
    margin:40px auto; 
    padding:0 30px; 
}

.welcome-header { margin-bottom: 35px; }

.welcome-header h3 { font-size: 32px; font-weight: 800; margin-bottom: 8px; }
.welcome-header p { color: var(--text-secondary); font-size: 16px; }

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
}

.stat-card {
    background: var(--surface);
    padding: 24px;
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
    transition: 0.2s;
    text-align: center;
}
.stat-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 35px rgba(0,0,0,.12);
}

.stat-val { font-size: 42px; font-weight: 800; display: block; margin-bottom: 5px; }
.stat-label { font-size: 13px; font-weight: 600; color: var(--text-secondary); letter-spacing: 0.5px; }

.section-title { font-size: 20px; font-weight: 700; margin-bottom: 20px; }

.actions-section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
}

.action-card {
    background: var(--surface);
    padding: 25px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: 0.2s;
    cursor: pointer;
    text-decoration: none;
    color: var(--text-primary);
}
.action-card:hover {
    transform: scale(1.02);
    border-color: var(--accent);
}

.action-info { display: flex; align-items: center; }
.action-icon { font-size: 24px; background: #F2F2F7; width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 15px; }
.action-text h4 { font-size: 17px; font-weight: 700; margin-bottom: 2px; }
.action-text p { font-size: 13px; color: var(--text-secondary); }
.action-arrow { color: #D1D1D6; font-size: 20px; font-weight: 800; }


.stat-card:nth-child(1){background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;}
.stat-card:nth-child(2){background:linear-gradient(135deg,#00c6ff,#0072ff);color:#fff;}
.stat-card:nth-child(3){background:linear-gradient(135deg,#f7971e,#ffd200);color:#fff;}
.stat-card:nth-child(4){background:linear-gradient(135deg,#ff416c,#ff4b2b);color:#fff;}
.stat-card:nth-child(-n+4) .stat-label{color:rgba(255,255,255,.9);}
.stat-card,.action-card{animation:fadeUp .6s ease;}
@keyframes fadeUp{
from{opacity:0;transform:translateY(20px);}
to{opacity:1;transform:none;}
}

footer {
    text-align: center;
    padding: 18px 0;
    color: var(--text-secondary);
    font-size: 14px;
}
</style>
</head>

<body>

<div class="navbar">
    <h2>🎵 Music Library Admin</h2>
    <button class="logout-btn" onclick="logout()">Logout</button>
</div>

<div class="page-content">
<div class="container">

    <div class="welcome-header">
        <h3>Dashboard</h3>
        <p>Welcome back, <span id="adminName" style="font-weight:600;">Admin</span>.</p>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div style="font-size:32px;margin-bottom:8px;">🎵</div><span class="stat-val" id="countSongs">-</span>
            <span class="stat-label">Library Songs</span>
        </div>
        <div class="stat-card">
            <div style="font-size:32px;margin-bottom:8px;">👥</div><span class="stat-val" id="countUsers">-</span>
            <span class="stat-label">Active Users</span>
        </div>
        <div class="stat-card">
            <div style="font-size:32px;margin-bottom:8px;">⭐</div><span class="stat-val" id="countPremium">-</span>
            <span class="stat-label">Premium Tracks</span>
        </div>
        <div class="stat-card">
            <div style="font-size:32px;margin-bottom:8px;">🚫</div><span class="stat-val" id="countBlocked">-</span>
            <span class="stat-label">Blocked Users</span>
        </div>
    </div>

    <div class="section-title">Quick Actions</div>

    <div class="actions-section">

        <a href="/admin/add-song" class="action-card">
            <div class="action-info">
                <div class="action-icon">📝</div>
                <div class="action-text">
                    <h4>Add New Song</h4>
                    <p>Upload MP3 & Cover Art</p>
                </div>
            </div>
            <span class="action-arrow">→</span>
        </a>

        <a href="/admin/songs" class="action-card">
            <div class="action-info">
                <div class="action-icon">🎵</div>
                <div class="action-text">
                    <h4>Manage Library</h4>
                    <p>Edit or Delete Songs</p>
                </div>
            </div>
            <span class="action-arrow">→</span>
        </a>

        <a href="/admin/users" class="action-card">
            <div class="action-info">
                <div class="action-icon">👥</div>
                <div class="action-text">
                    <h4>User Management</h4>
                    <p>Block or Remove Users</p>
                </div>
            </div>
            <span class="action-arrow">→</span>
        </a>


        <a href="/admin/notifications" class="action-card">
            <div class="action-info">
                <div class="action-icon">🔔</div>
                <div class="action-text">
                    <h4>Notifications</h4>
                    <p>View recent updates</p>
                </div>
            </div>
            <span class="action-arrow">→</span>
        </a>

    </div>
    <hr style="margin:50px 0;border:none;border-top:1px solid #ddd;">

<h2 class="section-title">Analytics</h2>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(420px,1fr));gap:25px;">

    <div class="action-card" style="display:block;cursor:default;">
        <h3 style="margin-bottom:20px;">🎵 Songs by Type</h3>
        <canvas id="songTypeChart"></canvas>
    </div>

    <div class="action-card" style="display:block;cursor:default;">
  <h3 style="margin-bottom:20px;">🎼 Songs by Music Director</h3>
        <canvas id="songChart"></canvas>
    </div>

</div>
</div>
</div>
<hr style="margin:50px 0;border:none;border-top:1px solid #ddd;">

<h2 class="section-title">🎵 Recently Added Songs</h2>

<div class="action-card" style="display:block;cursor:default;padding:25px;">

    <table id="recentSongsTable" style="width:100%;border-collapse:collapse;">

        <thead>
            <tr style="border-bottom:1px solid #ddd;">
                <th style="padding:12px;text-align:left;">Song</th>
                <th style="padding:12px;text-align:left;">Singer</th>
                <th style="padding:12px;text-align:left;">Music Director</th>
                <th style="padding:12px;text-align:left;">Type</th>
            </tr>
        </thead>

        <tbody id="recentSongsBody">
        </tbody>

    </table>

</div>
<footer>
    <p>&copy; 2025 Music Library Application. All rights reserved.</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Authentication
    const storedData = localStorage.getItem("admin");

    if (!storedData) {
        window.location.href = "/admin/login";
    }

    const admin = JSON.parse(storedData);
    document.getElementById("adminName").textContent =
        admin.adminName || admin.userName || "Super Admin";

    const JWT_TOKEN = admin.jwt;

    function logout() {
        localStorage.removeItem("admin");
        document.cookie = "jwtToken=; path=/; max-age=0";
        window.location.href = "/admin/login";
    }

    // APIs
    const SONGS_API = "/api/songs/all";
    const USERS_API = "http://192.168.1.52:8080/api/users/all";

    async function loadStats() {
        try {

            const songsRes = await fetch(SONGS_API, {
                headers: {
                    "Authorization": "Bearer " + JWT_TOKEN
                }
            });

            if (!songsRes.ok) {
                throw new Error("Failed to load songs");
            }

            const songs = await songsRes.json();

            const premiumSongs = songs.filter(
                song => song.songType &&
                        song.songType.toUpperCase() == "PREMIUM"
            ).length;

            const freeSongs = songs.length - premiumSongs;

            document.getElementById("countSongs").textContent = songs.length;
            document.getElementById("countPremium").textContent = premiumSongs;

            // Create Pie Chart
            if (songTypeChart) {
                songTypeChart.destroy();
            }

            songTypeChart = new Chart(
                document.getElementById("songTypeChart"),
                {
                    type: "pie",
                    data: {
                        labels: ["Premium", "Free"],
                        datasets: [{
                            data: [premiumSongs, freeSongs]
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                position: "bottom"
                            }
                        }
                    }
                }
            );

            // Songs by Music Director
            const directorCount = {};

            songs.forEach(song => {
                const director = song.musicDirector || "Unknown";
                directorCount[director] = (directorCount[director] || 0) + 1;
            });

            const sorted = Object.entries(directorCount)
                .sort((a, b) => b[1] - a[1])
                .slice(0, 5);

            const labels = sorted.map(item => item[0]);
            const values = sorted.map(item => item[1]);

            if (musicDirectorChart) {
                musicDirectorChart.destroy();
            }

            musicDirectorChart = new Chart(
                document.getElementById("songChart"),
                {
                    type: "bar",
                    data: {
                        labels: labels,
                        datasets: [{
                            label: "Songs",
                            data: values,
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                display: false
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0
                                }
                            }
                        }
                    }
                }
            );

        

         const recentSongsBody = document.getElementById("recentSongsBody");
         recentSongsBody.innerHTML = "";

         // Sort by newest first using libraryId
         const recentSongs = [...songs]
             .sort((a, b) => b.libraryId - a.libraryId)
             .slice(0, 5);

         recentSongs.forEach(song => {

             const row = document.createElement("tr");

             const badgeColor =
            	    song.songType === "PREMIUM" ? "#f39c12" : "#2ecc71";

            	row.innerHTML =
            	    "<td style='padding:12px;'>" + (song.songName || "-") + "</td>" +
            	    "<td style='padding:12px;'>" + (song.singer || "-") + "</td>" +
            	    "<td style='padding:12px;'>" + (song.musicDirector || "-") + "</td>" +
            	    "<td style='padding:12px;'>" +
            	        "<span style='padding:5px 12px;border-radius:20px;font-size:12px;font-weight:600;color:white;background:" + badgeColor + ";'>" +
            	            (song.songType || "-") +
            	        "</span>" +
            	    "</td>";

             recentSongsBody.appendChild(row);
         });
            const usersRes = await fetch(USERS_API, {
                headers: {
                    "Authorization": "Bearer " + JWT_TOKEN
                }
            });

            if (!usersRes.ok) {
                throw new Error("Failed to load users");
            }

            const users = await usersRes.json();

            const blockedUsers =
                users.filter(user => user.status == "INACTIVE").length;

            document.getElementById("countBlocked").textContent = blockedUsers;
            document.getElementById("countUsers").textContent =
                users.length - blockedUsers;

        } catch (error) {
            console.error("Dashboard Error:", error);
        }
    }

    let songTypeChart;
    let musicDirectorChart;

    loadStats();
</script>
</body>
</html>
