<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Add New Song</title>

<style>
:root{

--bg:#F5F5F7;
--surface:#FFFFFF;
--text:#1D1D1F;
--secondary:#86868B;
--border:#E5E5EA;

--primary:#0A84FF;
--primary2:#5E5CE6;

--danger:#FF2D55;

--radius:24px;

}

*{

margin:0;
padding:0;
box-sizing:border-box;
font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display",Inter,sans-serif;

}

body{

background:linear-gradient(180deg,#F8F8FA,#ECEEF5);

color:var(--text);

min-height:100vh;

display:flex;

flex-direction:column;

}

.page-wrapper{

flex:1;

display:flex;

justify-content:center;

padding:50px 25px;

}

.container{

width:100%;

max-width:1300px;

background:rgba(255,255,255,.95);

backdrop-filter:blur(18px);

border-radius:30px;

padding:45px;

box-shadow:

0 20px 60px rgba(0,0,0,.08),

0 8px 18px rgba(0,0,0,.05);

animation:fadeUp .45s ease;

}

h2{

font-size:40px;

font-weight:800;

margin-bottom:35px;

}

.error-msg{

background:#ffe8ec;

border:1px solid #ffc8d3;

color:#c50030;

padding:18px;

border-radius:16px;

margin-bottom:30px;

font-weight:700;

}

.content-layout{

display:grid;

grid-template-columns:380px 1fr;

gap:35px;

align-items:start;

}

.left-panel{

display:flex;

flex-direction:column;

gap:28px;

}

.right-panel{

display:flex;

flex-direction:column;

}

.card{

background:white;

border-radius:24px;

padding:24px;

border:1px solid var(--border);

box-shadow:0 10px 30px rgba(0,0,0,.05);

}

.card h3{

font-size:22px;

margin-bottom:20px;

font-weight:700;

}

.image-preview{

height:280px;

border:2px dashed #D8D8DD;

border-radius:22px;

background:#FAFAFC;

display:flex;

justify-content:center;

align-items:center;

overflow:hidden;

transition:.3s;

margin-bottom:20px;

}

.image-preview img{

width:100%;

height:100%;

object-fit:cover;

}

.audio-preview{

height:190px;

border:2px dashed #D8D8DD;

border-radius:22px;

background:#FAFAFC;

display:flex;

justify-content:center;

align-items:center;

transition:.3s;

margin-bottom:20px;

padding:20px;

}

.placeholder{

display:flex;

flex-direction:column;

align-items:center;

justify-content:center;

text-align:center;

color:#86868B;

}

.placeholder-icon{

font-size:56px;

margin-bottom:15px;

}

.upload-btn{

height:56px;

display:flex;

justify-content:center;

align-items:center;

background:linear-gradient(135deg,#0A84FF,#5E5CE6);

color:white;

border-radius:16px;

font-weight:700;

cursor:pointer;

transition:.25s;

user-select:none;

}

.upload-btn:hover{

transform:translateY(-2px);

box-shadow:0 15px 35px rgba(10,132,255,.30);

}

.form-grid{

display:grid;

grid-template-columns:repeat(2,1fr);

gap:22px;

}

.form-group{

display:flex;

flex-direction:column;

}

.form-group label{

font-size:14px;

font-weight:700;

margin-bottom:8px;

color:#1D1D1F;

}

.form-group input,

.form-group select{

height:56px;

padding:0 18px;

border-radius:16px;

border:1.5px solid #E5E5EA;

background:#FAFAFC;

font-size:15px;

transition:.25s;

}

.form-group input:focus,

.form-group select:focus{

outline:none;

background:white;

border-color:#0A84FF;

box-shadow:0 0 0 4px rgba(10,132,255,.10);

}

.audio-card{

display:flex;

flex-direction:column;

align-items:center;

justify-content:center;

text-align:center;

height:100%;

}

.audio-big-icon{

font-size:64px;

margin-bottom:15px;

}

.audio-file-name{

font-size:17px;

font-weight:700;

margin-bottom:10px;

word-break:break-word;

}

.audio-file-size{

font-size:14px;

color:#86868B;

}

.dragging{

transform:scale(1.02);

border-color:#0A84FF !important;

background:#EEF6FF !important;

}
</style>
</head>
<body>

<div class="page-wrapper">
<div class="container">

    <h2>📝 Add New Song</h2>

    <c:if test="${not empty errorMessage}">
        <div class="error-msg">${errorMessage}</div>
    </c:if>

    <form action="/admin/songs/add"
      method="post"
      enctype="multipart/form-data">

    <div class="content-layout">

        <div class="left-panel">

            <!-- Cover Card -->

            <div class="card">

                <h3>Cover Image</h3>

                <div id="imagePreview" class="image-preview">

                    <div class="placeholder">

                        <div class="placeholder-icon">🖼️</div>

                        <p>No Cover Selected</p>

                    </div>

                </div>

                <label class="upload-btn">

                    <input
                        id="imageInput"
                        type="file"
                        name="imageFile"
                        accept="image/*"
                        hidden>

                    Choose Cover

                </label>

            </div>

            <!-- Audio Card -->

            <div class="card">

                <h3>Audio File</h3>

                <div id="audioPreview" class="audio-preview">

                    <div class="placeholder">

                        <div class="placeholder-icon">🎵</div>

                        <p>No Audio Selected</p>

                    </div>

                </div>

                <label class="upload-btn">

                    <input
                        id="audioInput"
                        type="file"
                        name="file"
                        accept=".mp3,.wav"
                        hidden
                        required>

                    Choose Song

                </label>

            </div>

        </div>

        <div class="right-panel">

            <div class="form-grid">

    <div class="form-group">
        <label>Song Name</label>
        <input
            type="text"
            name="songName"
            placeholder="Enter Song Name"
            required>
    </div>

    <div class="form-group">
        <label>Singer</label>
        <input
            type="text"
            name="singer"
            placeholder="Singer Name"
            required>
    </div>

    <div class="form-group">
        <label>Album</label>
        <input
            type="text"
            name="albumName"
            placeholder="Album Name">
    </div>

    <div class="form-group">
        <label>Music Director</label>
        <input
            type="text"
            name="musicDirector"
            placeholder="Music Director">
    </div>

    <div class="form-group">
        <label>Release Date</label>
        <input
            type="date"
            name="releaseDate"
            max="9999-12-31">
    </div>

    <div class="form-group">
        <label>Song ID</label>
        <input
            type="number"
            name="songId"
            placeholder="101"
            required>
    </div>

    <div class="form-group">
        <label>Song Type</label>

        <select name="songType">
            <option value="FREE">FREE</option>
            <option value="PREMIUM">PREMIUM</option>
        </select>

    </div>

    <div class="form-group">
        <label>Status</label>

        <select name="songStatus">
            <option value="AVAILABLE">AVAILABLE</option>
            <option value="NOTAVAILABLE">NOT AVAILABLE</option>
        </select>

    </div>

</div>

<div class="button-row">

    <a href="/admin/songs"
       class="cancel-btn">
        Cancel
    </a>

    <button
        type="submit"
        class="submit-btn">

        🎵 Upload Song

    </button>

</div>

        </div>

    </div>

</form>
</div>
</div>

<footer>
    <p>&copy; 2025 Music Library Application. All rights reserved.</p>
</footer>

<script>
const imageInput = document.getElementById("imageInput");
const audioInput = document.getElementById("audioInput");

const imagePreview = document.getElementById("imagePreview");
const audioPreview = document.getElementById("audioPreview");

imageInput.addEventListener("change", function () {

    if (!this.files.length) {
        imagePreview.innerHTML = `
            <div class="placeholder">
                <div class="placeholder-icon">🖼️</div>
                <p>No Cover Selected</p>
            </div>
        `;
        return;
    }

    const reader = new FileReader();

    reader.onload = function (e) {

        imagePreview.innerHTML = `
            <img src="${e.target.result}" alt="Cover">
        `;

    };

    reader.readAsDataURL(this.files[0]);

});

audioInput.addEventListener("change", function () {

    if (!this.files.length) {
        audioPreview.innerHTML = `
            <div class="placeholder">
                <div class="placeholder-icon">🎵</div>
                <p>No Audio Selected</p>
            </div>
        `;
        return;
    }

    const file = this.files[0];

    const size = (file.size / (1024 * 1024)).toFixed(2);

    audioPreview.innerHTML = `
        <div class="audio-card">

            <div class="audio-big-icon">
                🎵
            </div>

            <div class="audio-file-name">
                ${file.name}
            </div>

            <div class="audio-file-size">
                ${size} MB
            </div>

        </div>
    `;

});

document.querySelectorAll(".upload-btn").forEach(label => {

    label.addEventListener("dragover", e => {
        e.preventDefault();
        label.classList.add("dragging");
    });

    label.addEventListener("dragleave", () => {
        label.classList.remove("dragging");
    });

    label.addEventListener("drop", e => {

        e.preventDefault();

        label.classList.remove("dragging");

        const input = label.querySelector("input");

        input.files = e.dataTransfer.files;

        input.dispatchEvent(new Event("change"));

    });

});
</script>

</body>
</html>
