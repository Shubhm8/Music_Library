<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Add New Songs</title>

<style>
:root{
    --bg:#F5F5F7;
    --card:#FFFFFF;
    --text:#1D1D1F;
    --secondary:#86868B;
    --border:#E5E5EA;
    --primary:#0A84FF;
    --primary2:#5E5CE6;
    --danger:#FF2D55;
    --success:#34C759;
    --radius:22px;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display",Inter,sans-serif;
}

body{
    background:var(--bg);
    color:var(--text);
    min-height:100vh;
    display:flex;
    flex-direction:column;
}

.page-wrapper{
    flex:1;
    display:flex;
    justify-content:center;
    padding:50px 20px;
}

.container{
    width:100%;
    max-width:1100px;
    background:var(--card);
    border-radius:28px;
    padding:45px;
    box-shadow:0 20px 60px rgba(0,0,0,.08);
    animation:fadeUp .5s ease;
}

.page-header{
    display:flex;
    align-items:center;
    gap:24px;
    margin-bottom:45px;
}

.header-icon{
    width:90px;
    height:90px;
    border-radius:28px;
    background:linear-gradient(135deg,#ff2d55,#ff7b94);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:42px;
    color:#fff;
    box-shadow:0 20px 40px rgba(255,45,85,.25);
}

.page-header h1{
    font-size:42px;
    font-weight:800;
    margin-bottom:8px;
}

.page-header p{
    color:var(--secondary);
    font-size:17px;
}

.error-msg{
    background:#ffe7eb;
    color:#d30033;
    padding:18px;
    border-radius:14px;
    margin-bottom:25px;
    border:1px solid #ffc6d2;
    font-weight:600;
}

.form-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:24px;
    margin-bottom:35px;
}

.form-group{
    display:flex;
    flex-direction:column;
}

.form-group label{
    font-size:15px;
    font-weight:700;
    margin-bottom:10px;
}

.form-group label span{
    color:var(--danger);
}

input,
select{
    width:100%;
    height:56px;
    border-radius:16px;
    border:1.5px solid var(--border);
    padding:0 18px;
    background:#FAFAFC;
    font-size:15px;
    transition:.25s;
}

input:focus,
select:focus{
    outline:none;
    border-color:var(--primary);
    background:#fff;
    box-shadow:0 0 0 4px rgba(10,132,255,.12);
}

.upload-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:28px;
    margin:40px 0;
}

.upload-card{
    background:#fbfbfd;
    border:1px solid var(--border);
    border-radius:22px;
    padding:24px;
}

.upload-card h3{
    font-size:21px;
    margin-bottom:18px;
}

.image-preview{
    height:260px;
    border:2px dashed #d7d7dc;
    border-radius:18px;
    display:flex;
    justify-content:center;
    align-items:center;
    overflow:hidden;
    margin-bottom:20px;
    background:white;
}

.image-preview img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.audio-preview{
    height:260px;
    border:2px dashed #d7d7dc;
    border-radius:18px;
    display:flex;
    justify-content:center;
    align-items:center;
    margin-bottom:20px;
    text-align:center;
    background:white;
    padding:20px;
}

.upload-box{
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    border:2px dashed var(--primary);
    border-radius:18px;
    min-height:110px;
    cursor:pointer;
    transition:.25s;
    background:#fff;
}

.upload-box:hover{
    background:#eef6ff;
    transform:translateY(-2px);
}

.upload-icon{
    font-size:34px;
    margin-bottom:10px;
}

.upload-box h4{
    font-size:18px;
    margin-bottom:6px;
}

.upload-box p{
    color:var(--secondary);
    font-size:14px;
}

.button-row{
    display:flex;
    justify-content:flex-end;
    gap:18px;
    margin-top:45px;
}

.cancel-btn{
    padding:16px 34px;
    border-radius:16px;
    background:#ececec;
    color:#222;
    text-decoration:none;
    font-weight:700;
    transition:.25s;
}

.cancel-btn:hover{
    background:#dddddd;
}

.submit-btn{
    border:none;
    padding:16px 38px;
    border-radius:16px;
    color:#fff;
    font-size:16px;
    font-weight:700;
    cursor:pointer;
    background:linear-gradient(135deg,var(--primary),var(--primary2));
    box-shadow:0 15px 35px rgba(10,132,255,.25);
    transition:.25s;
}

.submit-btn:hover{
    transform:translateY(-3px);
    box-shadow:0 22px 45px rgba(10,132,255,.35);
}

footer{
    padding:25px;
    text-align:center;
    color:var(--secondary);
}

@keyframes fadeUp{

from{
opacity:0;
transform:translateY(30px);
}

to{
opacity:1;
transform:none;
}

}

@media(max-width:900px){

.form-grid{
grid-template-columns:1fr;
}

.upload-grid{
grid-template-columns:1fr;
}

.page-header{
flex-direction:column;
text-align:center;
}

.button-row{
flex-direction:column;
}

.cancel-btn,
.submit-btn{
width:100%;
text-align:center;
}

.container{
padding:30px;
}

}
</style>
</head>
<body>

<div class="page-wrapper">

<div class="container">

<div class="page-header">

    <div class="header-icon">
        🎵
    </div>

    <div>

        <h1>Add New Song</h1>

        <p>
            Upload music to your library
        </p>

    </div>

</div>

    <c:if test="${not empty errorMessage}">
        <div class="error-msg">${errorMessage}</div>
    </c:if>

   <c:if test="${not empty errorMessage}">
    <div class="error-msg">
        ${errorMessage}
    </div>
</c:if>

<form action="/admin/songs/add"
      method="post"
      enctype="multipart/form-data">

    <div class="form-grid">

        <div class="form-group">
            <label>Song ID <span>*</span></label>
            <input
                type="number"
                name="songId"
                placeholder="Enter Song ID"
                required>
        </div>

        <div class="form-group">
            <label>Song Name <span>*</span></label>
            <input
                type="text"
                name="songName"
                placeholder="Enter Song Name"
                required>
        </div>

        <div class="form-group">
            <label>Singer <span>*</span></label>
            <input
                type="text"
                name="singer"
                placeholder="Singer Name"
                required>
        </div>

        <div class="form-group">
            <label>Album</label>
            <input
                type="text"
                name="albumName"
                placeholder="Album Name">
        </div>

        <div class="form-group">
            <label>Music Director</label>
            <input
                type="text"
                name="musicDirector"
                placeholder="Music Director">
        </div>

        <div class="form-group">
            <label>Release Date</label>
            <input
                type="date"
                name="releaseDate"
                max="9999-12-31">
        </div>

        <div class="form-group">
            <label>Song Type</label>

            <select name="songType">

                <option value="FREE">
                    FREE
                </option>

                <option value="PREMIUM">
                    PREMIUM
                </option>

            </select>

        </div>

        <div class="form-group">
            <label>Status</label>

            <select name="songStatus">

                <option value="AVAILABLE">
                    AVAILABLE
                </option>

                <option value="NOTAVAILABLE">
                    NOT AVAILABLE
                </option>

            </select>

        </div>

    </div>

    <div class="upload-grid">

        <div class="upload-card">

            <h3>Cover Image</h3>

            <div
                class="image-preview"
                id="imagePreview">

                <span>Select Cover Image</span>

            </div>

            <label
                class="upload-box">

                <input
                    type="file"
                    id="imageInput"
                    name="imageFile"
                    accept="image/*"
                    hidden>

                <div>

                    <div class="upload-icon">
                        🖼️
                    </div>

                    <h4>Choose Cover</h4>

                    <p>PNG • JPG • JPEG</p>

                </div>

            </label>

        </div>

        <div class="upload-card">

            <h3>Audio File</h3>

            <div
                class="audio-preview"
                id="audioPreview">

                <span>Select Audio File</span>

            </div>

            <label
                class="upload-box">

                <input
                    type="file"
                    id="audioInput"
                    name="file"
                    accept=".mp3,.wav"
                    required
                    hidden>

                <div>

                    <div class="upload-icon">
                        🎵
                    </div>

                    <h4>Choose Song</h4>

                    <p>MP3 • WAV</p>

                </div>

            </label>

        </div>

    </div>

    <div class="button-row">

        <a
            href="/admin/songs"
            class="cancel-btn">

            Cancel

        </a>

        <button
            type="submit"
            class="submit-btn">

            Upload Song

        </button>

    </div>

</form>
</div>
</div>

<footer>
    <p>&copy; 2025 Music Library Application. All rights reserved.</p>
</footer>


<script>

const imageInput = document.getElementById("imageInput");
const audioInput = document.getElementById("audioInput");

const imagePreview = document.getElementById("imagePreview");
const audioPreview = document.getElementById("audioPreview");

function bytesToMB(bytes){
    return (bytes / (1024 * 1024)).toFixed(2);
}

imageInput.addEventListener("change", function(){

    if(!this.files.length){
        imagePreview.innerHTML="<span>Select Cover Image</span>";
        return;
    }

    const file=this.files[0];

    if(!file.type.startsWith("image/")){
        alert("Please select a valid image.");
        this.value="";
        return;
    }

    const reader=new FileReader();

    reader.onload=function(e){

        imagePreview.innerHTML=`
            <img src="${e.target.result}" alt="Cover">
        `;

    };

    reader.readAsDataURL(file);

});

audioInput.addEventListener("change", function(){

    if(!this.files.length){
        audioPreview.innerHTML="<span>Select Audio File</span>";
        return;
    }

    const file=this.files[0];

    const icon=file.name.toLowerCase().endsWith(".wav")
        ? "🎼"
        : "🎵";

    audioPreview.innerHTML=`
        <div class="audio-card">

            <div class="audio-icon">
                ${icon}
            </div>

            <div class="audio-name">
                ${file.name}
            </div>

            <div class="audio-size">
                ${bytesToMB(file.size)} MB
            </div>

        </div>
    `;

});

document.querySelectorAll(".upload-box").forEach(box=>{

    box.addEventListener("dragover",e=>{
        e.preventDefault();
        box.classList.add("dragging");
    });

    box.addEventListener("dragleave",()=>{
        box.classList.remove("dragging");
    });

    box.addEventListener("drop",e=>{

        e.preventDefault();

        box.classList.remove("dragging");

        const input=box.querySelector("input");

        input.files=e.dataTransfer.files;

        input.dispatchEvent(new Event("change"));

    });

});
</script>


</body>
</html>
