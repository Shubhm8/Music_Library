# Copy to .env and replace every value before deploying.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
INTERNAL_API_KEY=replace-with-a-random-service-to-service-key
# Comma-separated browser origins permitted to call the services.
APP_ALLOWED_ORIGINS=https://your-domain.example
# Required only on the first deployment; remove these after the first admin is created.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret
PREMIUM_MONTHLY_PRICE_PAISE=9900
MAIL_USERNAME=
MAIL_PASSWORD=
